# Production environment template. `deploy/scripts/gen-env.sh` copies this to .env and fills every CHANGE_ME with a
# generated secret. Never commit the generated .env. Compose reads it for interpolation and for the services below.

# --- Identity of this installation ---
DOMAIN=CHANGE_ME_domain
PUBLIC_URL=https://CHANGE_ME_domain
# Image coordinates: <REGISTRY>/smb-api:<VERSION> and so on. Local builds use REGISTRY=smb (no host).
REGISTRY=smb
VERSION=0.1.0
# Published ports of the caddy container (the only published ports). Use 8443 for a local rehearsal.
HTTP_PORT=80
HTTPS_PORT=443
# prod for real installs. A local rehearsal that runs the end-to-end tests uses dev (dev-only CLI helpers).
APP_ENV=prod

# --- Database ---
POSTGRES_PASSWORD=CHANGE_ME_postgres
SMB_OWNER_PASSWORD=CHANGE_ME_owner
SMB_APP_PASSWORD=CHANGE_ME_app
KEYCLOAK_DB_PASSWORD=CHANGE_ME_keycloak_db

# --- Application ---
APP_SECRET_KEY=CHANGE_ME_secret_key
LOG_LEVEL=info
WORKER_CONCURRENCY=4
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
# Empty: simulated delivery. The shop chooses its SMTP provider (usually port 587 with STARTTLS).
# URL-encode credentials and query values; these are synthetic placeholders only.
# SMTP_URL=smtp://user:replace-me@mail.example.com:587?starttls=true&from=Shop%20Name%20%3Cno-reply@example.com%3E
# Alternative: smtps://user:replace-me@mail.example.com:465?from=no-reply@example.com
SMTP_URL=
# Used if the SMTP_URL has no from query parameter.
SMTP_FROM=
# Comma-separated hosts the backend may call. Add the host of each hosted AI provider you give a key below:
#   api.vultrinference.com, api.openai.com, generativelanguage.googleapis.com, api.anthropic.com
EGRESS_ALLOWLIST=

# --- AI (docs/roadmap/ai/contracts.md §2). AI stays disabled until config/ai-routes.yaml exists and a provider of
#     its agent route has a key. install.sh creates config/ai-routes.yaml from ai-routes.example.yaml once. ---
AI_ROUTES_FILE=/config/ai-routes.yaml
# Provider keys (secrets): leave empty to skip that provider.
VULTR_INFERENCE_API_KEY=
OPENAI_API_KEY=
ANTHROPIC_API_KEY=
GEMINI_API_KEY=
# DNS names a `hosted: false` provider (llama.cpp) may reach over plain HTTP on a private address; empty disables it.
LOCAL_INFERENCE_HOSTS=
# Tokens (input + output) per business per UTC day when the business sets no budget of its own.
AI_DAILY_TOKEN_BUDGET_PER_BUSINESS=2000000

# --- Keycloak ---
OIDC_CLIENT_SECRET=CHANGE_ME_oidc_client
KEYCLOAK_ADMIN_CLIENT_SECRET=CHANGE_ME_kc_admin_client
KEYCLOAK_BOOTSTRAP_ADMIN_USER=admin
KEYCLOAK_BOOTSTRAP_ADMIN_PASSWORD=CHANGE_ME_kc_bootstrap

# --- Backups (restic). For a Vultr Object Storage repository use
#     RESTIC_REPOSITORY=s3:https://sjc1.vultrobjects.com/smb-backups and the bucket's access keys. ---
RESTIC_REPOSITORY=
RESTIC_PASSWORD=CHANGE_ME_restic
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=

# Regulated profile requires both signed-agreement attestations (plain text, max 200 chars).
DATA_PROFILE=standard
REGULATED_HOST_BAA=
REGULATED_BACKUP_BAA=

# Host watchdog JSON webhook; empty means local logging only (never sent to containers).
ALERT_WEBHOOK_URL=
