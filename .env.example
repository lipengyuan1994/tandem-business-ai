# Copy to .env for local development. Never commit .env. All values here are safe dummies.
APP_ENV=dev
APP_BASE_URL=https://localhost:8443
APP_SECRET_KEY=dev-only-change-me-0123456789abcdef0123456789abcdef
DATABASE_URL=postgresql+psycopg://smb_app:smb_app_dev@postgres:5432/smb
DATABASE_MIGRATION_URL=postgresql+psycopg://smb_owner:smb_owner_dev@postgres:5432/smb
TEST_DATABASE_URL=postgresql+psycopg://smb_app:smb_app_dev@localhost:5433/smb
TEST_DATABASE_MIGRATION_URL=postgresql+psycopg://smb_owner:smb_owner_dev@localhost:5433/smb
SESSION_TTL_HOURS=12
SESSION_IDLE_MINUTES=60
OIDC_ISSUER=https://localhost:8443/auth/realms/smb
OIDC_INTERNAL_ISSUER_URL=http://keycloak:8080/auth/realms/smb
OIDC_CLIENT_ID=smb-app
OIDC_CLIENT_SECRET=dev-only-smb-app-secret
KEYCLOAK_ADMIN_CLIENT_ID=smb-admin
KEYCLOAK_ADMIN_CLIENT_SECRET=dev-only-smb-admin-secret
# Empty: simulated delivery. The shop chooses its SMTP provider (usually port 587 with STARTTLS).
# URL-encode credentials and query values; these are synthetic placeholders only.
# SMTP_URL=smtp://user:replace-me@mail.example.com:587?starttls=true&from=Shop%20Name%20%3Cno-reply@example.com%3E
# Alternative: smtps://user:replace-me@mail.example.com:465?from=no-reply@example.com
SMTP_URL=
# Used if the SMTP_URL has no from query parameter.
SMTP_FROM=
OBJECT_STORAGE_ENDPOINT=
OBJECT_STORAGE_BUCKET=
OBJECT_STORAGE_ACCESS_KEY=
OBJECT_STORAGE_SECRET_KEY=
RESTIC_REPOSITORY=
RESTIC_PASSWORD=
# Dev: every AI model class goes to the scripted `fake` provider (deploy/config, mounted at /config), no key needed.
# For real providers use /config/ai-routes.example.yaml (or your own copy) and set a key below.
AI_ROUTES_FILE=/config/ai-routes.dev.yaml
AI_FAKE_SCRIPT_FILE=/config/ai-fake-script.dev.yaml
VULTR_INFERENCE_API_KEY=
OPENAI_API_KEY=
GEMINI_API_KEY=
ANTHROPIC_API_KEY=
EGRESS_ALLOWLIST=api.vultrinference.com
# Optional local HTTP transport: exact DNS hostnames only (for example localhost), empty disables it.
LOCAL_INFERENCE_HOSTS=
AI_DAILY_TOKEN_BUDGET_PER_BUSINESS=2000000
WORKER_CONCURRENCY=4
LOG_LEVEL=info
DEV_TEST_EXECUTORS=0

# Regulated profile requires both signed-agreement attestations (plain text, max 200 chars).
DATA_PROFILE=standard
REGULATED_HOST_BAA=
REGULATED_BACKUP_BAA=
